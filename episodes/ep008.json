 "lines": [
  {
   "spk": "tamsin",
   "text": "Okay. The party is tonight. We still don't have a group costume.",
   "shot": "W",
   "gesture": "hips"
  },
  {
   "spk": "derek",
   "text": "So we play the game. We're not gonna be.",
   "shot": "TWO",
   "gesture": "point"
  },
  {
   "spk": "waffles",
   "text": "I'll start. We're not gonna be cats.",
   "shot": "CU",
   "gesture": "cross"
  },
  {
   "spk": "waffles",
   "text": "I'm already a cat. That's my whole life. Get your own thing.",
   "shot": "CU",
   "gesture": "hips",
   "after": "rimshot"
  },
  {
   "spk": "tamsin",
   "text": "Fair. Box, what do we have?",
   "shot": "TWO",
   "gesture": "point"
  },
  {
   "spk": "box",
   "text": "Hello. I am the costume box. I have seen things.",
   "shot": "CU"
  },
  {
   "spk": "box",
   "text": "I contain one cape, one shoe, some antlers, and a banana suit.",
   "shot": "CU",
   "gesture": "shrug"
  },
  {
   "spk": "derek",
   "text": "Just one shoe?",
   "shot": "CU",
   "gesture": "think"
  },
  {
   "spk": "box",
   "text": "We don't talk about the other shoe.",
   "shot": "CU",
   "pre": 0.6,
   "after": "sting"
  },
  {
   "spk": "tamsin",
   "text": "Okay. We're not gonna be superheroes. We have one cape.",
   "shot": "CU",
   "gesture": "facepalm"
  },
  {
   "spk": "derek",
   "text": "One of us flies. The rest of us run behind him.",
   "shot": "CU",
   "gesture": "arms_up",
   "jump": true
  },
  {
   "spk": "waffles",
   "text": "That's not a costume. That's a jogging group.",
   "shot": "CU"
  },
  {
   "spk": "tamsin",
   "text": "We're not gonna be a jogging group.",
   "shot": "W",
   "gesture": "cross",
   "after": "ding"
  },
  {
   "spk": "derek",
   "text": "What about a ghost? Everyone has a sheet.",
   "shot": "CU",
   "gesture": "point"
  },
  {
   "spk": "box",
   "text": "Every ghost in this box is just a sheet with regrets.",
   "shot": "CU"
  },
  {
   "spk": "tamsin",
   "text": "Plus Derek was a ghost last year.",
   "shot": "TWO",
   "gesture": "point"
  },
  {
   "spk": "derek",
   "text": "I was a ghost for six hours. I walked into four doors.",
   "shot": "CU",
   "gesture": "facepalm"
  },
  {
   "spk": "waffles",
   "text": "Five. I counted.",
   "shot": "waffles",
   "gesture": "shrug"
  },
  {
   "spk": "tamsin",
   "text": "We're not gonna be ghosts.",
   "shot": "W",
   "gesture": "cross"
  },
  {
   "spk": "derek",
   "text": "Okay, okay. I have a big one. Ready?",
   "shot": "CU",
   "gesture": "arms_up",
   "jump": true
  },
  {
   "spk": "tamsin",
   "text": "No.",
   "shot": "CU",
   "gesture": "cross"
  },
  {
   "spk": "derek",
   "text": "We go as the weather.",
   "shot": "CU",
   "gesture": "wave"
  },
  {
   "spk": "tamsin",
   "text": "The weather.",
   "shot": "CU",
   "gesture": "think",
   "pre": 0.8
  },
  {
   "spk": "derek",
   "text": "I'm the sun, you're a cloud, Waffles is a light breeze.",
   "shot": "CU",
   "gesture": "point"
  },
  {
   "spk": "waffles",
   "text": "I am not a breeze. I have never once been a breeze.",
   "shot": "CU",
   "gesture": "hips"
  },
  {
   "spk": "tamsin",
   "text": "Nobody at a party wants to talk to the forecast.",
   "shot": "TWO",
   "gesture": "facepalm",
   "after": "boing"
  },
  {
   "spk": "tamsin",
   "text": "We're not gonna be the weather.",
   "shot": "W",
   "gesture": "cross"
  },
  {
   "spk": "derek",
   "text": "Then we go as a crowd. We just stand there together.",
   "shot": "CU",
   "gesture": "shrug"
  },
  {
   "spk": "waffles",
   "text": "That's just us. At the party. With no costume.",
   "shot": "CU"
  },
  {
   "spk": "derek",
   "text": "Yes, but on purpose.",
   "shot": "CU",
   "gesture": "point",
   "jump": true
  },
  {
   "spk": "tamsin",
   "text": "Derek, a crowd is not a costume. A crowd is a situation.",
   "shot": "CU",
   "gesture": "facepalm"
  },
  {
   "spk": "tamsin",
   "text": "We're not gonna be a crowd.",
   "shot": "W",
   "gesture": "cross",
   "after": "record_scratch"
  },
  {
   "spk": "tamsin",
   "text": "Okay, the banana suit. Let's talk about it.",
   "shot": "CU",
   "gesture": "think"
  },
  {
   "spk": "box",
   "text": "Please don't. The banana has been through a lot.",
   "shot": "CU",
   "pre": 0.5
  },
  {
   "spk": "derek",
   "text": "Why is there a stain on the banana?",
   "shot": "TWO",
   "gesture": "point"
  },
  {
   "spk": "box",
   "text": "Some questions are bigger than Halloween.",
   "shot": "CU"
  },
  {
   "spk": "waffles",
   "text": "I'm not touching it. And I lick myself.",
   "shot": "CU",
   "gesture": "cross",
   "after": "rimshot"
  },
  {
   "spk": "tamsin",
   "text": "We're not gonna be bananas.",
   "shot": "W",
   "gesture": "cross"
  },
  {
   "spk": "derek",
   "text": "So what's left?",
   "shot": "CU",
   "gesture": "shrug"
  },
  {
   "spk": "tamsin",
   "text": "A cape, a shoe, and some antlers.",
   "shot": "CU",
   "gesture": "think"
  },
  {
   "spk": "derek",
   "text": "A reindeer who flies and only needs one shoe.",
   "shot": "CU",
   "gesture": "arms_up",
   "jump": true
  },
  {
   "spk": "waffles",
   "text": "That's not a costume. That's a craft project that gave up.",
   "shot": "CU"
  },
  {
   "spk": "tamsin",
   "text": "We're not gonna be a craft project.",
   "shot": "W",
   "gesture": "cross"
  },
  {
   "spk": "derek",
   "text": "Okay, what time is this party anyway?",
   "shot": "CU",
   "gesture": "shrug"
  },
  {
   "spk": "tamsin",
   "text": "Eight o'clock. Whose house is it at again?",
   "shot": "CU",
   "gesture": "think"
  },
  {
   "spk": "waffles",
   "text": "Let me check the invitation.",
   "shot": "waffles",
   "gesture": "think"
  },
  {
   "spk": "waffles",
   "text": "It says our address.",
   "shot": "CU",
   "pre": 0.9,
   "after": "record_scratch"
  },
  {
   "spk": [
    "tamsin",
    "derek"
   ],
   "text": "Our address?",
   "shot": "W",
   "gesture": "arms_up"
  },
  {
   "spk": "box",
   "text": "Oh no. You're hosting.",
   "shot": "CU"
  },
  {
   "spk": "derek",
   "text": "We're hosting? Who invited everyone?",
   "shot": "CU",
   "gesture": "facepalm"
  },
  {
   "spk": "waffles",
   "text": "You did. Three weeks ago. You said, leave it to me.",
   "shot": "TWO",
   "gesture": "point"
  },
  {
   "spk": "derek",
   "text": "That does sound like something I would say.",
   "shot": "CU",
   "gesture": "shrug",
   "pre": 0.6
  },
  {
   "spk": "tamsin",
   "text": "There's no snacks. There's no music. There's no costume.",
   "shot": "CU",
   "gesture": "arms_up"
  },
  {
   "spk": "box",
   "text": "There is one shoe.",
   "shot": "CU",
   "after": "ding"
  },
  {
   "spk": "tamsin",
   "text": "Okay. Everybody grab something from the box. Now.",
   "shot": "W",
   "gesture": "point"
  },
  {
   "spk": "derek",
   "text": "I've got the cape and the antlers.",
   "shot": "CU",
   "gesture": "arms_up",
   "jump": true
  },
  {
   "spk": "tamsin",
   "text": "I've got the shoe. Just the one.",
   "shot": "CU",
   "gesture": "shrug"
  },
  {
   "spk": "waffles",
   "text": "And I'll wear the banana.",
   "shot": "CU",
   "pre": 0.6
  },
  {
   "spk": [
    "tamsin",
    "derek"
   ],
   "text": "You said you wouldn't touch it!",
   "shot": "W",
   "gesture": "point"
  },
  {
   "spk": "waffles",
   "text": "I'm a cat. I change my mind. That's my costume.",
   "shot": "CU",
   "gesture": "hips"
  },
  {
   "spk": "derek",
   "text": "So what are we? As a group?",
   "shot": "CU",
   "gesture": "think"
  },
  {
   "spk": "tamsin",
   "text": "We're a costume box that couldn't decide.",
   "shot": "CU",
   "gesture": "arms_up"
  },
  {
   "spk": "box",
   "text": "Finally. Somebody gets me.",
   "shot": "CU",
   "after": "applause"
  },
  {
   "spk": "waffles",
   "text": "We're not gonna be invited to anything next year.",
   "shot": "W",
   "gesture": "shrug"
  }
 ]
